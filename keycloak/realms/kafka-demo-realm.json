{
  "realm": "kafka-demo",
  "displayName": "Kafka Demo (local)",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "accessTokenLifespan": 900,
  "roles": {
    "realm": [
      {
        "name": "customer-admin",
        "description": "Create and read customers"
      },
      {
        "name": "viewer",
        "description": "Read-only access to customers, emails and analytics"
      }
    ]
  },
  "clients": [
    {
      "clientId": "kafka-demo-ui",
      "name": "Kafka Demo UI",
      "description": "Public SPA client: authorization code flow with PKCE",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "http://localhost:5173/*",
        "http://localhost:8080/*"
      ],
      "webOrigins": [
        "http://localhost:5173",
        "http://localhost:8080"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:5173/*##http://localhost:8080/*"
      },
      "protocolMappers": [
        {
          "name": "audience-kafka-demo-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "kafka-demo-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "kafka-demo-api",
      "name": "Kafka Demo API",
      "description": "Audience for the customer, email and analytics services (resource servers). Also usable for service-to-service calls with client credentials.",
      "enabled": true,
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "local",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": true,
      "protocolMappers": [
        {
          "name": "audience-kafka-demo-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "kafka-demo-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "kafkaDemoAdmin",
      "email": "admin.user@kafka-demo.local",
      "firstName": "Admin",
      "lastName": "User",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "local",
          "temporary": false
        }
      ],
      "realmRoles": [
        "customer-admin",
        "viewer",
        "default-roles-kafka-demo"
      ]
    },
    {
      "username": "kafkaDemoViewer",
      "email": "viewer.user@kafka-demo.local",
      "firstName": "Viewer",
      "lastName": "User",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "local",
          "temporary": false
        }
      ],
      "realmRoles": [
        "viewer",
        "default-roles-kafka-demo"
      ]
    }
  ]
}

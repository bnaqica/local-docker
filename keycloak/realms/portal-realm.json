{
  "enabled": true,
  "sslRequired": "none",
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "accessTokenLifespan": 300,
  "bruteForceProtected": true,
  "permanentLockout": true,
  "maxTemporaryLockouts": 3,
  "failureFactor": 5,
  "waitIncrementSeconds": 60,
  "maxFailureWaitSeconds": 900,
  "eventsEnabled": true,
  "eventsExpiration": 2592000,
  "adminEventsEnabled": true,
  "adminEventsDetailsEnabled": false,
  "smtpServer": {
    "host": "mailpit",
    "port": "1025",
    "from": "no-reply@crm.local",
    "fromDisplayName": "CRM Demo"
  },
  "realm": "portal",
  "displayName": "Customer Portal",
  "registrationAllowed": true,
  "registrationEmailAsUsername": true,
  "verifyEmail": true,
  "resetPasswordAllowed": true,
  "passwordPolicy": "length(12) and notUsername and notEmail",
  "actionTokenGeneratedByUserLifespan": 1800,
  "roles": {
    "realm": [
      {
        "name": "external-starter",
        "description": "Self-registered portal user",
        "composite": true,
        "composites": {
          "client": {
            "portal-app": [
              "external-starter"
            ]
          }
        }
      },
      {
        "name": "external-standard",
        "description": "Promoted or invited portal user",
        "composite": true,
        "composites": {
          "client": {
            "portal-app": [
              "external-standard"
            ]
          }
        }
      }
    ],
    "client": {
      "portal-app": [
        {
          "name": "external-starter",
          "description": "Self-registered portal user"
        },
        {
          "name": "external-standard",
          "description": "Promoted or invited portal user"
        }
      ]
    }
  },
  "clients": [
    {
      "clientId": "portal-app",
      "name": "Customer Portal",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "http://localhost:5174/*"
      ],
      "webOrigins": [
        "http://localhost:5174"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:5174/*"
      }
    },
    {
      "clientId": "ums-portal",
      "description": "UMS user management in portal",
      "enabled": true,
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "ums-portal-local-secret",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": true,
      "defaultClientScopes": [
        "roles",
        "basic",
        "service_account"
      ],
      "optionalClientScopes": []
    }
  ],
  "users": [
    {
      "username": "service-account-ums-portal",
      "enabled": true,
      "serviceAccountClientId": "ums-portal",
      "clientRoles": {
        "realm-management": [
          "manage-users",
          "view-users",
          "query-groups",
          "view-clients",
          "manage-clients",
          "view-realm"
        ]
      }
    }
  ]
}
